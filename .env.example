# ==============================================================================
# INHUBFLOW | SOCIAL SELLING SUITE - CONFIGURACION DE ENTORNO
# ==============================================================================

# UNIPILE GATEWAY & LINKEDIN ENGINE
# El modo sin credenciales proporciona solo simulaciones parciales para desarrollo;
# no es un sandbox de extremo a extremo ni persiste los datos como una base SaaS.
# El cliente solo llama a Unipile cuando DSN y API key estan definidos y sandbox es false.
UNIPILE_SANDBOX_MODE=false
INHUBFLOW_ENABLE_WEBHOOK_SIMULATOR=false
NEXT_PUBLIC_INHUBFLOW_DEMO_DATA=false
UNIPILE_DSN=
UNIPILE_API_KEY=
UNIPILE_WEBHOOK_SECRET=whsec_inhubflow_production

# APP CONFIG
NEXT_PUBLIC_APP_URL=http://localhost:3000
