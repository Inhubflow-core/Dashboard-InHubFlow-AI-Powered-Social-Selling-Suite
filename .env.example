# ==============================================================================
# INHUBFLOW | SOCIAL SELLING SUITE - CONFIGURACION DE ENTORNO
# ==============================================================================

# UNIPILE GATEWAY & LINKEDIN ENGINE
# NOTA: La suite cuenta con emulador Sandbox de Alta Fidelidad.
# Mientras no definas UNIPILE_DSN y UNIPILE_API_KEY, la plataforma opera en modo Sandbox,
# preservando al 100% tus 7 dias de prueba gratuitos de Unipile sin gastar cuota.
UNIPILE_SANDBOX_MODE=false
UNIPILE_DSN=
UNIPILE_API_KEY=
UNIPILE_WEBHOOK_SECRET=whsec_inhubflow_production

# APP CONFIG
NEXT_PUBLIC_APP_URL=http://localhost:3000
